{
  "1": {
    "class_type": "EmptyLatentAudio",
    "inputs": {
      "batch_size": 1,
      "seconds": 8.0
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative_prompt}}"
    }
  },
  "4": {
    "class_type": "KSampler",
    "inputs": {
      "cfg": 7.0,
      "denoise": 1.0,
      "latent_image": ["1", 0],
      "negative": ["3", 0],
      "positive": ["2", 0],
      "sampler_name": "dpmpp_3m_sde",
      "scheduler": "exponential",
      "seed": "{{seed}}",
      "steps": "{{steps}}"
    }
  },
  "5": {
    "class_type": "SaveAudio",
    "inputs": {
      "audio": ["4", 0],
      "filename_prefix": "editroom_sfx"
    }
  }
}
